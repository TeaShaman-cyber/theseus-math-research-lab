#!/usr/bin/env python3
import argparse,hashlib,json,pathlib,re,subprocess
ROOT=pathlib.Path(__file__).resolve().parents[2]
def main():
    ap=argparse.ArgumentParser(); ap.add_argument('--probe',required=True); ap.add_argument('--out',type=pathlib.Path,required=True); ap.add_argument('--mcporter',default='/workspace/tools/mcporter/bin/mcporter'); a=ap.parse_args()
    reg=json.loads((ROOT/'probes/registry.json').read_text())['probes']; rel=reg.get(a.probe)
    if not rel: raise SystemExit(f'unknown registered probe: {a.probe}')
    wl=(ROOT/rel).parent/'wolfram.wl'
    if not wl.is_file(): raise SystemExit(f'no Wolfram witness for {a.probe}')
    try:
        p=subprocess.run([a.mcporter,'call','wolfram.WolframLanguageEvaluator',f'code=@{wl}','timeConstraint=60'],text=True,capture_output=True)
    except (FileNotFoundError,PermissionError,OSError) as exc:
        p=subprocess.CompletedProcess([],127,'',f'{type(exc).__name__}: {exc}')
    raw=(p.stdout+'\n'+p.stderr).strip(); payload=None; m=re.search(r'\{\s*".*?"\}',raw,re.S)
    if m:
        try: payload=json.loads(m.group(0))
        except Exception: payload=None
    if p.returncode!=0 or not isinstance(payload,dict): status='DEGRADED_EXTERNAL_WITNESS'
    elif payload.get('pass') is True: status='VERIFIED'
    elif payload.get('pass') is False: status='FAIL_ASSERTION'
    else: status='DEGRADED_EXTERNAL_WITNESS'
    rec={'schema':'theseus.math-research-wolfram-witness.v1','probe_id':a.probe,'witness_sha256':hashlib.sha256(wl.read_bytes()).hexdigest(),'transport':{'client':'mcporter','server':'wolfram','tool':'WolframLanguageEvaluator','returncode':p.returncode},'status':status,'payload':payload,'raw_excerpt':raw[:2000]}
    a.out.parent.mkdir(parents=True,exist_ok=True); a.out.write_text(json.dumps(rec,indent=2,sort_keys=True)+'\n'); print(json.dumps(rec,sort_keys=True,separators=(',',':'))); return 0 if status=='VERIFIED' else (1 if status=='FAIL_ASSERTION' else 2)
if __name__=='__main__': raise SystemExit(main())
