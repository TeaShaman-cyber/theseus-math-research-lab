#!/usr/bin/env python3
import argparse,json,pathlib,re,subprocess,sys,tempfile
ROOT=pathlib.Path(__file__).resolve().parents[2]
HERE=pathlib.Path(__file__).resolve().parent
if str(HERE) not in sys.path:
    sys.path.insert(0,str(HERE))
from wolfram_adapter import render_wolfram_probe
def main():
    ap=argparse.ArgumentParser(); ap.add_argument('--probe',required=True); ap.add_argument('--out',type=pathlib.Path,required=True); ap.add_argument('--mcporter',default='/workspace/tools/mcporter/bin/mcporter'); a=ap.parse_args()
    try:
        rendered=render_wolfram_probe(ROOT,a.probe)
    except ValueError as exc:
        raise SystemExit(str(exc))
    try:
        with tempfile.NamedTemporaryFile('w',suffix='.wl',encoding='utf-8') as handle:
            handle.write(rendered['code']); handle.flush()
            p=subprocess.run([a.mcporter,'call','wolfram.WolframLanguageEvaluator',f'code=@{handle.name}','timeConstraint=60'],text=True,capture_output=True)
    except (FileNotFoundError,PermissionError,OSError) as exc:
        p=subprocess.CompletedProcess([],127,'',f'{type(exc).__name__}: {exc}')
    raw=(p.stdout+'\n'+p.stderr).strip(); payload=None
    for line in raw.splitlines():
        m=re.match(r'^\s*Out\[\d+\]\s*=\s*(.+?)\s*$',line)
        if not m:
            continue
        try:
            value=json.loads(m.group(1))
            if isinstance(value,str): value=json.loads(value)
            if isinstance(value,dict):
                payload=value
                break
        except Exception:
            pass
    if payload is None:
        m=re.search(r'\{\s*".*?"\}',raw,re.S)
        if m:
            try: payload=json.loads(m.group(0))
            except Exception: payload=None
    if p.returncode!=0 or not isinstance(payload,dict): status='DEGRADED_EXTERNAL_WITNESS'
    elif payload.get('pass') is True: status='VERIFIED'
    elif payload.get('pass') is False: status='FAIL_ASSERTION'
    else: status='DEGRADED_EXTERNAL_WITNESS'
    rec={'schema':'theseus.math-research-wolfram-witness.v2','probe_id':a.probe,'witness_sha256':rendered['binding']['rendered_sha256'],'source_binding':rendered['binding'],'transport':{'client':'mcporter','server':'wolfram','tool':'WolframLanguageEvaluator','returncode':p.returncode},'status':status,'payload':payload,'raw_excerpt':raw[:2000]}
    a.out.parent.mkdir(parents=True,exist_ok=True); a.out.write_text(json.dumps(rec,indent=2,sort_keys=True)+'\n'); print(json.dumps(rec,sort_keys=True,separators=(',',':'))); return 0 if status=='VERIFIED' else (1 if status=='FAIL_ASSERTION' else 2)
if __name__=='__main__': raise SystemExit(main())
